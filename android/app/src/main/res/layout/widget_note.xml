<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/n_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_bg" android:scaleType="fitXY" android:contentDescription="@null"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<TextView android:id="@+id/n_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="4dp" android:textColor="#202124" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
<ImageView android:id="@+id/n_open" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/round_button" android:padding="7dp" android:src="@drawable/ic_w_open" android:contentDescription="開く"/>
</LinearLayout>
<ListView android:id="@+id/n_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:divider="@null"/>
<TextView android:id="@+id/n_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="@string/widget_note_empty" android:textColor="#70757A" android:textSize="12sp"/>
</LinearLayout>
</FrameLayout>
