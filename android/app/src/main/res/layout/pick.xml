<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F8F9FA">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="ウィジェットに表示するメモ" android:textColor="#202124" android:textSize="18sp" android:textStyle="bold"/>
<EditText android:id="@+id/p_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:hint="検索" android:inputType="text" android:importantForAutofill="no"/>
<ListView android:id="@+id/p_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="8dp" android:divider="@null" android:dividerHeight="6dp"/>
</LinearLayout>
